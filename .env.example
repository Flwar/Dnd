NEXT_PUBLIC_SUPABASE_URL=
# עדיף מפתח publishable בפרויקטים חדשים. בפרויקט ותיק אפשר להשאיר ריק ולהגדיר במקום זאת NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# מפתח שרת בלבד. Vercel Marketplace מגדיר אותו אוטומטית. נדרש לפקודות משחק סמכותיות; לעולם לא לחשוף בדפדפן.
SUPABASE_SECRET_KEY=
# חלופה בלבד לפרויקטים ותיקים המשתמשים במפתח service_role:
# SUPABASE_SERVICE_ROLE_KEY=
# אופציונלי להרצת SQL מנהלי ידנית; npm run db:validate אינו משתמש בו.
SUPABASE_DB_URL=
# חלופה בלבד ל־NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY בפרויקטי Supabase ותיקים:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# מקור קנוני ללא לוכסן סופי; לעדכן לדומיין HTTPS לפני בדיקת אימייל ושחזור סיסמה.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
